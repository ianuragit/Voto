# ---- Voto configuration -----------------------------------------------------
# Copy to .env for local development. In production these are Railway variables;
# nothing secret belongs in the repository.

NODE_ENV=development
PORT=3000

# Public origin used to build magic links. Must match the deployed domain
# exactly, or the links in the invite emails will point somewhere else.
PUBLIC_BASE_URL=http://localhost:3000

# Where auth.sqlite and tally.sqlite live. On Railway this is the volume mount.
DATA_DIR=./data

# HMAC key for creator sessions, sign-in links and CSRF tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-48-random-bytes

# Who may create polls (§12 Q1). Comma-separated, lowercase.
ALLOWED_CREATORS=you@yourdomain.com

# ---- SMTP --------------------------------------------------------------------
# Provider-neutral: any relay works. For ZeptoMail use smtp.zeptomail.com, or
# smtp.zeptomail.in for India-region accounts.
#
# SMTP_USER is the literal string "emailapikey" and SMTP_PASSWORD is the Mail
# Agent's SMTP token — NOT the Send Mail API token. The two are issued
# separately and the API one is refused with 535 over SMTP.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
# Leave SMTP_SECURE unset: it is derived from the port (true only on 465).
# SMTP_SECURE=
SMTP_USER=emailapikey
SMTP_PASSWORD=

MAIL_FROM_ADDRESS=voto@yourdomain.com
MAIL_FROM_NAME=Voto
# Envelope sender. Bounces return here rather than to the From address.
MAIL_BOUNCE_ADDRESS=bounces@yourdomain.com

# Bounce webhook (still a ZeptoMail feature, independent of how mail is sent).
ZEPTOMAIL_WEBHOOK_SECRET=
ZEPTOMAIL_WEBHOOK_SIGNATURE_HEADER=x-zoho-signature

# With SMTP unconfigured, or this set, emails are printed instead of sent.
EMAIL_DRY_RUN=false
