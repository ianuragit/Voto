# ---- Voto configuration -----------------------------------------------------
# Copy to .env for local development. In production these are Railway variables;
# nothing secret belongs in the repository.

NODE_ENV=development
PORT=3000

# Public origin used to build magic links. Must match the deployed domain
# exactly, or the links in the invite emails will point somewhere else.
PUBLIC_BASE_URL=http://localhost:3000

# Where auth.sqlite and tally.sqlite live. On Railway this is the volume mount.
DATA_DIR=./data

# HMAC key for creator sessions, sign-in links and CSRF tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-48-random-bytes

# Who may create polls (§12 Q1). Comma-separated, lowercase.
ALLOWED_CREATORS=you@yourdomain.com

# ---- ZeptoMail --------------------------------------------------------------
# api.zeptomail.com for global accounts, api.zeptomail.in for India-region ones.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=voto@yourdomain.com
ZEPTOMAIL_FROM_NAME=Voto
ZEPTOMAIL_BOUNCE_ADDRESS=bounces@yourdomain.com
ZEPTOMAIL_WEBHOOK_SECRET=
ZEPTOMAIL_WEBHOOK_SIGNATURE_HEADER=x-zoho-signature

# With no API key, or with this set, emails are printed instead of sent.
EMAIL_DRY_RUN=false
